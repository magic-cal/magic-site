+  // Note: intentionally not using path.join() here - it treats the hostname as a
+  // filesystem path and mangles the "//" after the URL scheme (breaks on Windows,
+  // and only "works" on POSIX by accident via WHATWG URL leniency).
+  const host = (
+    options.hostname || (req && `${isHTTPS(req) ? 'https' : 'http'}://${req.headers.host}`) || `http://${hostname()}`
+  ).replace(/\/+$/, '')
+  const basePath = base && base !== '/' ? `/${String(base).replace(/^\/+|\/+$/g, '')}` : ''
+  return `${host}${basePath}`
 }
 
